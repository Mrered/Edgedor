{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Edgedor",
  "version": "0.1.17",
  "identifier": "com.mrered.edgedor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Edgedor",
        "width": 800,
        "height": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      {
        "ext": ["txt", "md", "markdown", "json", "js", "jsx", "ts", "tsx", "rs", "py", "go", "java", "c", "h", "cpp", "css", "html", "xml", "yaml", "yml", "toml", "sh"],
        "name": "Edgedor Text",
        "role": "Editor",
        "mimeType": "text/plain"
      },
      {
        "ext": ["png", "jpg", "jpeg", "gif", "webp", "pdf"],
        "name": "Edgedor Preview",
        "role": "Viewer"
      }
    ],
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "26.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVBNTE5REJCQjU4MjQ3QQpSV1I2SkZpNzJ4bWxEc1NyQ1FSaWIrT2FoeitxUGVGQmJKSFR0NmRHWk11YzhPeVAyRi9HUS9UTQo=",
      "endpoints": [
        "https://github.com/Mrered/Edgedor/releases/latest/download/latest.json"
      ]
    }
  }
}
