{
  "name": "edgedor",
  "version": "0.1.15",
  "description": "A macOS edge workspace for transient code and text",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:session": "node --experimental-strip-types src/lib/session/selfcheck.ts",
